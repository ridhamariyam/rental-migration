# Copy to .env.local for local development. Never commit real secrets.

# Postgres connection string for this app's own database. Runs on port 5435
# (see docker-compose.yml in this folder) — deliberately not 5432, since the
# legacy backend's own compose file (and possibly other local projects) may
# already be using that port. `docker compose up -d` starts it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/rental_migration"

# Secret used to sign/verify session-related tokens (NOT the DB session
# token itself, which is random and only ever stored hashed). Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-value-min-32-chars"

# Platform super admin login (Phase 1). There is exactly one super admin for
# this MVP, defined here rather than in the database. Change these before
# deploying anywhere reachable.
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-to-a-strong-password"

# development | production | test
NODE_ENV="development"

# Base URL of this app, used for building absolute links (e.g. in emails).
NEXT_PUBLIC_APP_URL="http://localhost:3003"

# Cloudinary (Phase 9 — product/variation cover image uploads). Create a
# free account at https://cloudinary.com, then copy these three values from
# your dashboard's "API Environment variable" (it's shown there as one
# `CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>` string —
# split it into the three vars below). Never commit real values.
CLOUDINARY_CLOUD_NAME="change-me"
CLOUDINARY_API_KEY="change-me"
CLOUDINARY_API_SECRET="change-me"

# Mapbox (outlet location picker map + attendance geofence map). Create a
# free account at https://account.mapbox.com/, then copy your "Default
# public token" (starts with `pk.`) from the Access tokens page. This is a
# PUBLIC token meant to ship in client JS — restrict it to your own URLs
# from the Mapbox dashboard, never put a secret token here. Optional: the
# map picker/geofence map gracefully fall back to manual coordinate entry
# and a plain distance readout when this is left blank.
NEXT_PUBLIC_MAPBOX_TOKEN="change-me"

# MSG91 WhatsApp notifications. Tenants onboard numbers/templates inside
# MSG91, then this app syncs those assets and sends mapped template messages.
MSG91_AUTHKEY="change-me"
MSG91_WHATSAPP_BASE_URL="https://api.msg91.com/api/v5/whatsapp"
# Shared secret the cron/worker sends as the `x-worker-secret` header when
# triggering `/api/internal/notifications/dispatch`. Generate with:
#   openssl rand -hex 32
NOTIFICATION_WORKER_SECRET="change-me-to-a-long-random-value-min-32-chars"
# Shared secret MSG91 must send back as `?token=...` on its webhook callback
# URL (`/api/webhooks/msg91/whatsapp?token=...`, configured in the MSG91
# dashboard) — MSG91 doesn't sign its webhook payloads, so without this the
# endpoint would accept a forged status update from anyone on the internet.
# Generate with: openssl rand -hex 32
MSG91_WEBHOOK_SECRET="change-me-to-a-long-random-value-min-32-chars"
WHATSAPP_DEFAULT_COUNTRY_CODE="91"
