# Test environment. Points at a throwaway local database that the test
# harness truncates between suites — never point this at a real database.
# Committed on purpose (no secrets here) so `pnpm test` works on a fresh
# clone; see README § Testing.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/rental_migration_test"
SESSION_SECRET="test-session-secret-that-is-long-enough-1234567890"
NODE_ENV="test"
NEXT_PUBLIC_APP_URL="http://localhost:3003"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="test-super-admin-password"
STORAGE_BUCKET="test-bucket"
STORAGE_ACCESS_KEY_ID="test-access-key"
STORAGE_SECRET_ACCESS_KEY="test-secret-key"
MSG91_AUTHKEY=""
NOTIFICATION_WORKER_SECRET="test-notification-worker-secret-1234567890abcd"
MSG91_WEBHOOK_SECRET="test-msg91-webhook-secret-1234567890abcdefgh"
WHATSAPP_DEFAULT_COUNTRY_CODE="91"
