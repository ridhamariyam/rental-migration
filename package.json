{
  "name": "rental-migration",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "test": "tsx --conditions=react-server --env-file=.env.test --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:tenants": "tsx scripts/seed-demo-tenants.ts",
    "notifications:worker": "tsx --env-file=.env.local scripts/notification-worker.ts",
    "test:watch": "tsx --conditions=react-server --env-file=.env.test --test --test-concurrency=1 --watch \"src/**/*.test.ts\"",
    "test:db:setup": "tsx --env-file=.env.test scripts/setup-test-db.ts",
    "notifications:dispatch": "tsx scripts/dispatch-notifications.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@zxing/browser": "0.2.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.33.0",
    "mapbox-gl": "^3.29.0",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.27.0"
}
